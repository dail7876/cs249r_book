# ════════════════════════════════════════════════════════════
# 智能营销业务系统 环境变量配置
# 复制此文件为 .env 并填入实际值
# ════════════════════════════════════════════════════════════

# ── 应用基础 ──────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production
COMPANY_NAME=您的公司名称

# ── AI 对话（选填其一）────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
# 如使用国内代理，设置 BASE_URL
# AI_BASE_URL=https://api.your-proxy.com/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# ── 微信企业号 ────────────────────────────────────────────────
WECHAT_CORP_ID=your_corp_id
WECHAT_CORP_SECRET=your_corp_secret
WECHAT_AGENT_ID=your_agent_id
WECHAT_TOKEN=your_token
WECHAT_ENCODING_AES_KEY=your_encoding_aes_key

# 微信群机器人 Webhook（推送通知用）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ── 钉钉 ──────────────────────────────────────────────────────
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret
DINGTALK_ROBOT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_ROBOT_SECRET=your_robot_secret
DINGTALK_CORP_ID=your_corp_id

# ── 邮件 ──────────────────────────────────────────────────────
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your_app_password_or_auth_code
EMAIL_CHECK_INTERVAL=300

# ── 数据库 ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/business.db

# ── Redis（可选，用于任务队列）────────────────────────────────
REDIS_URL=redis://localhost:6379/0
