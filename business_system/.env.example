# ============================================================
# 自动化业务分析系统 - 环境变量配置示例
# 复制为 .env 并填入真实配置
# ============================================================

# ── 应用 ──────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-secret-key-in-production
DEBUG=false

# ── 数据库 ─────────────────────────────────────────────────────
# 默认 SQLite，生产环境推荐 PostgreSQL
DATABASE_URL=sqlite:///./database/business.db
# DATABASE_URL=postgresql://user:password@localhost:5432/business_db

# ── AI 对话 (Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096

# ── 企业微信 ──────────────────────────────────────────────────
WECHAT_CORP_ID=your_corp_id
WECHAT_CORP_SECRET=your_corp_secret
WECHAT_AGENT_ID=your_agent_id
WECHAT_TOKEN=your_token_for_signature
WECHAT_ENCODING_AES_KEY=your_aes_key

# ── 钉钉 ──────────────────────────────────────────────────────
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret
DINGTALK_ROBOT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_ROBOT_SECRET=your_robot_secret
DINGTALK_AGENT_ID=your_agent_id

# ── 邮件 ──────────────────────────────────────────────────────
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_CHECK_INTERVAL=60
